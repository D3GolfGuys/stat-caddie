# ── Database ──────────────────────────────────────────
# Railway provides this automatically. For local dev, use a local PostgreSQL URL.
DATABASE_URL=postgresql://user:password@localhost:5432/statcaddie

# ── Auth ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create these in your Stripe dashboard under Products
STRIPE_INDIVIDUAL_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ── App ───────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# ── Course database (optional — pre-fills par/hcp/yardage on capture) ──
# Free key (email only) at https://golfcourseapi.com. Without it, course
# lookup is simply disabled and hole info is entered manually as before.
GOLF_COURSE_API_KEY=
# Override only if using a different provider/host:
# GOLF_COURSE_API_URL=https://api.golfcourseapi.com

# ── Email (invites, password resets, welcome) ─────────
# Production uses Resend's HTTPS API. Railway blocks outbound SMTP on Free /
# Trial / Hobby plans, so SMTP there fails with "Connection timeout" no matter
# how good the credentials are.
# Key from https://resend.com → API Keys. MAIL_FROM must be on a domain
# verified in Resend (DNS records added at GoDaddy).
RESEND_API_KEY=
MAIL_FROM=College Golf Metrics <admin@collegegolfmetrics.com>
# MAIL_REPLY_TO=admin@collegegolfmetrics.com

# SMTP fallback — used only when RESEND_API_KEY is unset. Fine for local dev or
# a host that permits outbound SMTP. SMTP_PASS is a 16-character Google App
# Password (Security → 2-Step Verification → App passwords), not the mailbox
# password.
# SMTP_USER=admin@collegegolfmetrics.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# FROM_EMAIL=noreply@statcaddie.com
